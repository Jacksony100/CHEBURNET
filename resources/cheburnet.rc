#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "GeneratedVersion.h"

/////////////////////////////////////////////////////////////////////////////
// Multi-resolution CHEBURNET application icon.
IDI_APPICON ICON "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Application manifest: requireAdministrator + DPI + UTF-8.
// Linked with /MANIFEST:NO so this is the only manifest.
1 RT_MANIFEST "generated/app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION CHEBURNET_VERSION_QUAD
 PRODUCTVERSION CHEBURNET_VERSION_QUAD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName",      "CHEBURNET Labs"
            VALUE "Comments",         "CHEBURNET LABS // РАЗРАБОТАНО MARSHAL JACKSONY100"
            VALUE "FileDescription",  "CHEBURNET — управление соединением"
            VALUE "FileVersion",      CHEBURNET_VERSION_RC_STR
            VALUE "InternalName",     "CHEBURNET"
            VALUE "LegalCopyright",   "CHEBURNET (MIT). Уведомления и лицензии сторонних компонентов включены."
            VALUE "OriginalFilename", "CHEBURNET.exe"
            VALUE "ProductName",      "CHEBURNET"
            VALUE "ProductVersion",   CHEBURNET_VERSION_RC_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
